---
interface Props {
	id: string;
	title: string;
	contentLabel: string;
	contentValue: string;
	copyButtonText: string;
	copyFeedbackText: string;
	closeButtonLabel: string;
}

const { id, title, contentLabel, contentValue, copyButtonText, copyFeedbackText, closeButtonLabel } = Astro.props;
const dialogId = `${id}Dialog`;
const titleId = `${id}DialogTitle`;
---

<dialog id={dialogId} class="modal-dialog" aria-labelledby={titleId} {...({ closedby: 'any' } as any)}>
	<div class="modal-header">
		<h2 id={titleId} class="modal-title">{title}</h2>
		<button type="button" class="modal-close" aria-label={closeButtonLabel}>&times;</button>
	</div>
	<div class="modal-body">
		<p><code id={contentLabel}>{contentValue}</code></p>
		<button class="btn-copy" autofocus onclick={`copyID('${contentLabel}', '${id}Feedback')`}>{copyButtonText}</button>
		<div id={`${id}Feedback`} class="feedback" role="status" data-text={copyFeedbackText}></div>
	</div>
</dialog>

<style>
	.modal-dialog {
		border: 1px solid var(--color-card-border);
		border-radius: var(--radius);
		background: var(--color-card-bg);
		color: var(--color-text);
		padding: 0;
		max-width: 400px;
		width: calc(100% - 2rem);
	}
	.modal-dialog:modal {
		overscroll-behavior: contain;
	}
	.modal-dialog::backdrop {
		background: rgba(0, 0, 0, 0.5);
		overflow: hidden;
		overscroll-behavior: contain;
	}
	.modal-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1rem;
		border-bottom: 1px solid var(--color-card-border);
	}
	.modal-title {
		font-size: 1.25rem;
		font-weight: 600;
		margin: 0;
	}
	.modal-close {
		background: none;
		border: none;
		font-size: 1.5rem;
		line-height: 1;
		cursor: pointer;
		color: var(--color-text-muted);
		padding: 0.25rem 0.5rem;
	}
	.modal-close:hover {
		color: var(--color-text);
	}
	.modal-close:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 2px;
	}
	.modal-body {
		padding: 1.5rem;
		text-align: center;
	}
	.modal-body code {
		font-size: 1rem;
	}
	.btn-copy {
		background: none;
		border: 1px solid var(--color-accent);
		color: var(--color-accent);
		padding: 0.5rem 0.75rem;
		border-radius: var(--radius);
		cursor: pointer;
		font-size: 1rem;
		transition: background-color 0.15s, color 0.15s;
	}
	.btn-copy:hover,
	.btn-copy:active {
		background: var(--color-accent);
		color: var(--color-on-accent);
	}
	.btn-copy:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 2px;
	}
	.feedback {
		color: var(--color-success);
		margin-top: 0.5rem;
	}
	.feedback:empty {
		margin-top: 0;
	}
</style>

<script is:inline define:vars={{ dialogId }}>
	(function() {
		const dialog = document.getElementById(dialogId);
		if (!dialog) return;
		dialog.querySelector('.modal-close').addEventListener('click', () => dialog.close());

		// closedby 非対応ブラウザ向け。ドラッグ選択の終点が外側でも閉じないよう押下位置も見る
		if ('closedBy' in HTMLDialogElement.prototype) return;
		const isOutside = (event) => {
			const rect = dialog.getBoundingClientRect();
			return event.clientX < rect.left || event.clientX > rect.right ||
				event.clientY < rect.top || event.clientY > rect.bottom;
		};
		let pressedOutside = false;
		dialog.addEventListener('pointerdown', (event) => {
			pressedOutside = isOutside(event);
		});
		dialog.addEventListener('pointerup', (event) => {
			if (pressedOutside && isOutside(event)) dialog.close();
		});
	})();
</script>
